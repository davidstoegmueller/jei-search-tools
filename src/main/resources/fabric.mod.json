{
  "schemaVersion": 1,
  "id": "jei-search-tools",
  "version": "${version}",
  "name": "JEI Search Tools",
  "description": "Additional search tools for Just Enough Items. (JEI)",
  "authors": ["daveestar"],
  "icon": "assets/jei-search-tools/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": ["com.daveestar.jeisearchtools.client.JEISearchToolsClient"],
    "jei_mod_plugin": ["com.daveestar.jeisearchtools.client.jei.JEIModPlugin"]
  },
  "mixins": [
    {
      "config": "jei-search-tools.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "~26.3",
    "java": ">=25",
    "fabric-api": "*",
    "jei": ">=31.12.0.65"
  }
}
